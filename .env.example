# Copy this file to .env.local for local testing. On Vercel, add these under
# Project > Settings > Environment Variables.

# Added automatically when you connect Upstash Redis from the Vercel Marketplace.
# Without them the app keeps dynamic links in memory (local testing only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Your public address, for example https://openqr.vercel.app
NEXT_PUBLIC_SITE_URL=

# Link to your GitHub repo, shown in the footer.
NEXT_PUBLIC_REPO_URL=

# A long random secret for /api/admin (at least 16 characters).
ADMIN_TOKEN=

# Any random text. Used to hash visitor IPs for rate limiting.
RATE_LIMIT_SALT=

# Optional: Google Safe Browsing API key. Blocks known phishing and malware links.
GOOGLE_SAFE_BROWSING_KEY=

# Optional: comma-separated domains you never want to redirect to.
BLOCKED_DOMAINS=

# Optional: how many dynamic codes one network can create per hour (default 20).
CREATE_LIMIT_PER_HOUR=20
